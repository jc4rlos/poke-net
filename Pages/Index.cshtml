@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,_theme(colors.poke.blue)/25%,_transparent_60%)]"></div>
    <div class="mx-auto max-w-6xl px-6 py-24 text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/5 px-4 py-1.5 text-sm text-slate-300 ring-1 ring-white/10">
            🔴 POC &mdash; ASP.NET Core 8 + Tailwind CSS
        </span>
        <h1 class="mt-6 text-5xl sm:text-6xl font-extrabold tracking-tight">
            Atrápalos a todos con
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-poke-red via-poke-yellow to-poke-blue">
                PokéNet
            </span>
        </h1>
        <p class="mt-6 text-lg text-slate-400 max-w-2xl mx-auto">
            Una landing sencilla para validar el stack: Razor Pages renderizando datos desde C#,
            estilos con Tailwind y un endpoint de salud listo para monitoreo.
        </p>
        <div class="mt-10 flex items-center justify-center gap-4">
            <a href="#pokedex"
               class="rounded-lg bg-poke-red px-6 py-3 font-semibold shadow-lg shadow-poke-red/30 hover:bg-red-600 transition-colors">
                Ver Pokédex
            </a>
            <a href="/health"
               class="rounded-lg px-6 py-3 font-semibold ring-1 ring-white/15 hover:bg-white/5 transition-colors">
                Estado del servicio
            </a>
        </div>
    </div>
</section>

<section id="pokedex" class="mx-auto max-w-6xl px-6 pb-24">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <h2 class="text-2xl font-bold">Pokédex destacada</h2>
        <div class="relative w-full sm:w-72">
            <input type="search" id="pokemonSearch" placeholder="Buscar por nombre..."
                   class="w-full rounded-lg bg-white/5 px-4 py-2.5 text-sm ring-1 ring-white/10 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-poke-blue transition-shadow"
                   autocomplete="off" />
        </div>
    </div>
    <p id="noResults" class="hidden text-slate-400 text-center py-12">
        No se encontraron Pokémon con ese nombre.
    </p>
    <div id="pokemonGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var pokemon in Model.FeaturedPokemon)
        {
            <article class="group rounded-2xl bg-white/5 ring-1 ring-white/10 p-6 hover:ring-white/25 hover:bg-white/[0.07] transition-all cursor-pointer pokemon-card" data-pokemon-id="@pokemon.Id" data-pokemon-name="@pokemon.Name.ToLowerInvariant()">
                <div class="flex items-center justify-center h-32">
                    <img src="@pokemon.SpriteUrl" alt="@pokemon.Name"
                         class="h-full object-contain drop-shadow-lg group-hover:scale-105 transition-transform" loading="lazy" />
                </div>
                <div class="mt-4 flex items-center justify-between">
                    <h3 class="font-semibold text-lg">@pokemon.Name</h3>
                    <span class="text-xs font-mono text-slate-500">#@pokemon.Id.ToString("000")</span>
                </div>
                <span class="mt-3 inline-block rounded-full px-3 py-1 text-xs font-medium ring-1 @pokemon.TypeBadgeClasses">
                    @pokemon.Type
                </span>
            </article>
        }
    </div>
</section>

<div id="pokemonModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
    <div class="bg-slate-900 rounded-2xl max-w-md w-full ring-1 ring-white/10 shadow-2xl">
        <div class="p-6">
            <button id="closeModal" class="float-right text-slate-400 hover:text-white text-2xl">&times;</button>
            <div id="modalContent" class="mt-4 text-center">
                <div class="h-40 flex items-center justify-center">
                    <img id="modalImage" src="" alt="" class="h-full object-contain" />
                </div>
                <h2 id="modalName" class="text-2xl font-bold mt-4"></h2>
                <p id="modalType" class="text-sm text-slate-400 mt-2"></p>
                <p id="modalDescription" class="text-slate-300 mt-4 text-sm leading-relaxed"></p>
            </div>
        </div>
    </div>
</div>

<script src="~/js/index.js"></script>
