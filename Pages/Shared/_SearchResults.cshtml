<template x-if="searchResults.length > 0">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
        <template x-for="pokemon in searchResults" :key="pokemon.id">
            <article class="group rounded-2xl bg-white/5 ring-1 ring-white/10 p-6 hover:ring-white/25 hover:bg-white/[0.07] transition-all cursor-pointer"
                     @@click="loadPokemonFromSearch(pokemon)">
                <div class="flex items-center justify-center h-32">
                    <img :src="pokemon.spriteUrl" :alt="pokemon.name"
                         class="h-full object-contain drop-shadow-lg group-hover:scale-105 transition-transform" loading="lazy" />
                </div>
                <div class="mt-4 flex items-center justify-between">
                    <h3 class="font-semibold text-lg" x-text="capitalize(pokemon.name)"></h3>
                    <span class="text-xs font-mono text-slate-500" x-text="`#${pokemon.id.toString().padStart(3, '0')}`"></span>
                </div>
                <span class="mt-3 inline-block rounded-full px-3 py-1 text-xs font-medium ring-1 capitalize" :class="getTypeColor(pokemon.type)"
                      x-text="pokemon.type"></span>
            </article>
        </template>
    </div>
</template>
