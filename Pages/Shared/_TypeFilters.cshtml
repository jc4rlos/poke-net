<div class="mb-8">
    <p class="text-sm text-slate-400 mb-3">Filtrar por tipo:</p>
    <div class="flex flex-wrap gap-2">
        <template x-for="type in types" :key="type">
            <button @@click="filterByType(type)"
                    :class="{
                      'bg-blue-500 text-white ring-blue-400': selectedType === type,
                      'bg-white/5 text-slate-300 hover:bg-white/10 ring-white/10': selectedType !== type
                    }"
                    class="rounded-full px-4 py-2 text-sm font-medium ring-1 transition-colors capitalize">
                <span x-text="type"></span>
            </button>
        </template>
    </div>
</div>
